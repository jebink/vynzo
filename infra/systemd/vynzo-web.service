[Unit]
Description=VYNZO web (Next.js)
After=network-online.target vynzo-api.service
Wants=network-online.target

[Service]
User=admin
WorkingDirectory=/home/admin/vynzo/apps/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NEXT_PUBLIC_API_BASE_URL=http://192.168.31.11:8000
ExecStart=/home/admin/vynzo/apps/web/node_modules/.bin/next start --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
