# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL/TimescaleDB. Used by the API, the workers and dbmate (scripts/migrate.sh).
# Dev server: 192.168.31.11; on the server itself: localhost.
DATABASE_URL=postgresql://market:CHANGE_ME@localhost:5432/market?sslmode=disable

# API
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Web (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# analytics-worker: news sentiment (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Optional: Uptime Kuma push monitor URL for the data-freshness check
KUMA_PUSH_URL=

# Optional: off-host backup target for scripts/backup_db.sh (rsync destination)
BACKUP_REMOTE=
